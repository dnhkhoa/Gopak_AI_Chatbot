# Base URL of the FastAPI backend (used in real mode)
VITE_API_BASE_URL=http://127.0.0.1:8000/api

# API mode: "real" calls FastAPI, "mock" uses in-browser fixtures (no backend needed)
VITE_API_MODE=real

# Developer tools (debug panel / raw metadata) — hidden from customers by default
VITE_ENABLE_DEVELOPER_TOOLS=false
